# The only place the real model API keys live (SEC-03). Hermes and the api get LiteLLM virtual keys instead.
LITELLM_MASTER_KEY=
DATABASE_URL=postgresql://office:<POSTGRES_PASSWORD>@postgres:5432/litellm
ANTHROPIC_API_KEY=
# Empty until the OpenAI account exists; the "gambar" alias then fails and the image adapter stays on mock.
OPENAI_API_KEY=
