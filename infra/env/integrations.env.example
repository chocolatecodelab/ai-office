# Kredensial layanan luar (Google, Meta, TikTok, YouTube, WhatsApp, Scalev, Trello). Isi hanya nama yang dibutuhkan; Settings > Integrasi menunjukkan mana yang masih kosong.
# File ini di luar git. Kunci OpenAI untuk GPT Image ada di litellm.env.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SCALEV_API_KEY=
TRELLO_API_KEY=
TRELLO_TOKEN=
# Kunci enkripsi token akun yang terhubung lewat OAuth (32 byte base64). Dibuat otomatis oleh scripts/setup-env.mjs; jangan diganti setelah ada akun terhubung.
INTEGRATIONS_ENCRYPTION_KEY=
# Alamat publik Ruang untuk callback OAuth. Kosongkan di laptop (dipakai http://127.0.0.1:<port>); isi di VPS, mis. https://ruang.contoh.id
RUANG_PUBLIC_URL=
