# Kredensial layanan luar (Google, Meta, TikTok, YouTube, WhatsApp, Scalev, Trello). Isi hanya nama yang dibutuhkan; Settings > Integrasi menunjukkan mana yang masih kosong.
# File ini di luar git. Kunci OpenAI untuk GPT Image ada di litellm.env.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Publikasi feed melalui Page Access Token. Versi Graph mengikuti aplikasi Meta Anda (format vXX.0).
# Izin Facebook: pages_manage_posts, pages_read_engagement. Instagram: instagram_basic, instagram_content_publish.
# Token dan ID selalu dipilih per brand. Isi hanya akun yang akan digunakan.
META_GRAPH_VERSION=
META_OTCA_PAGE_ACCESS_TOKEN=
META_OTCA_PAGE_ID=
META_OTCA_INSTAGRAM_ID=
META_INFOJERMAN_PAGE_ACCESS_TOKEN=
META_INFOJERMAN_PAGE_ID=
META_INFOJERMAN_INSTAGRAM_ID=
META_CIAOMANDA_PAGE_ACCESS_TOKEN=
META_CIAOMANDA_PAGE_ID=
META_CIAOMANDA_INSTAGRAM_ID=
META_JEPANGKOEY_PAGE_ACCESS_TOKEN=
META_JEPANGKOEY_PAGE_ID=
META_JEPANGKOEY_INSTAGRAM_ID=
# Origin HTTPS publik yang mengarah ke server AI Office, tanpa path. Diperlukan agar Meta bisa mengambil salinan JPEG bertanda tangan.
OFFICE_MEDIA_PUBLIC_URL=
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SCALEV_API_KEY=
TRELLO_API_KEY=
TRELLO_TOKEN=
# Kunci enkripsi token akun yang terhubung lewat OAuth (32 byte base64). Dibuat otomatis oleh scripts/setup-env.mjs; jangan diganti setelah ada akun terhubung.
INTEGRATIONS_ENCRYPTION_KEY=
# Alamat publik Ruang untuk callback OAuth. Kosongkan di laptop (dipakai http://127.0.0.1:<port>); isi di VPS, mis. https://ruang.contoh.id
RUANG_PUBLIC_URL=
