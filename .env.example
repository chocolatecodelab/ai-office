# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Chat attachment capacity (server environment; restart the API after changing).
OFFICE_UPLOAD_MAX_MB=25
OFFICE_CHAT_MAX_FILES=20
OFFICE_LIBRARY_MAX_FILES=500
OFFICE_LIBRARY_MAX_MB=1024
# Processing batch size and final document context are independent of upload capacity.
OFFICE_PDF_BATCH_PAGES=3
OFFICE_DOCUMENT_CONTEXT_CHARS=24000
# Recent chat history budget in characters, independent of uploaded document capacity.
OFFICE_CHAT_HISTORY_CHARS=12000
